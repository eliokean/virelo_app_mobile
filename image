        const eurToggle = document.getElementById('eur-toggle');

        function updateDisplay() {
            let symbol = currentCurrency === "USD" ? "$" : "€";
            let formatted = parseFloat(currentAmount).toLocaleString(undefined, {
                minimumFractionDigits: currentAmount.includes('.') ? currentAmount.split('.')[1].length : 0,
                maximumFractionDigits: 2
            });

            // Logic to keep the trailing zeros visible if they were typed
            if (currentAmount.endsWith('.')) {
                display.innerText = `${symbol}${formatted}.`;
            } else if (currentAmount.includes('.') && currentAmount.endsWith('0')) {
                display.innerText = `${symbol}${currentAmount}`;
            } else {
                display.innerText = `${symbol}${formatted}`;
            }
        }

        function appendDigit(digit) {
            if (currentAmount === "0" && digit !== ".") {
                currentAmount = digit;
            } else {
                // Prevent multiple decimals
                if (digit === "." && currentAmount.includes(".")) return;

                // Prevent more than 2 decimal places
                if (currentAmount.includes(".")) {
                    const parts = currentAmount.split(".");
                    if (parts[1].length >= 2) return;
                }

                // Limit max amount for UI safety
                if (currentAmount.replace('.', '').length >= 9) return;

                currentAmount += digit;
            }
            updateDisplay();
        }

        function deleteDigit() {
            if (currentAmount.length > 1) {
                currentAmount = currentAmount.slice(0, -1);
                if (currentAmount.endsWith('.')) {
                    // visual fix for backspacing decimal
                }
            } else {
                currentAmount = "0";
            }
            updateDisplay();
        }

        function setCurrency(curr) {
            currentCurrency = curr;
            if (curr === "USD") {
                usdToggle.classList.add('bg-on-background', 'text-on-primary');
                usdToggle.classList.remove('text-on-surface-variant');
                eurToggle.classList.remove('bg-on-background', 'text-on-primary');
                eurToggle.classList.add('text-on-surface-variant');
            } else {
                eurToggle.classList.add('bg-on-background', 'text-on-primary');
                eurToggle.classList.remove('text-on-surface-variant');
                usdToggle.classList.remove('bg-on-background', 'text-on-primary');
                usdToggle.classList.add('text-on-surface-variant');
            }
            updateDisplay();
        }

        // Haptic-like feedback on keypad
        document.querySelectorAll('.keypad-button').forEach(btn => {
            btn.addEventListener('click', () => {
                if (window.navigator.vibrate) {
                    window.navigator.vibrate(10);
                }
            });
        });
    </script>
